# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Maven build output; keep the wrapper jar (in backend/.mvn/) despite *.jar above
target/
!**/.mvn/wrapper/maven-wrapper.jar

# Node and frontend build output
node_modules/
dist/
*.tsbuildinfo
.vite/

# Test output (coverage, Playwright)
coverage/
playwright-report/
test-results/
blob-report/

# Private source notes (not published)
CrewUp App.docx

# Windows download leftovers when copying files into WSL
*:Zone.Identifier

# Local secrets and config (see CLAUDE.md)
.env
.env.*
!.env.example
application-local.yml
