{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "CrewUp API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "paths" : {
    "/api/crews" : {
      "get" : {
        "tags" : [ "Crews" ],
        "summary" : "List the caller's crews",
        "description" : "Sorted by name, one page at a time.",
        "operationId" : "myCrews",
        "parameters" : [ {
          "name" : "cursor",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 50,
            "maximum" : 100,
            "minimum" : 1
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "One page of the caller's crews",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CursorPageCrewSummary"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid cursor or limit",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401" : {
            "description" : "Missing or invalid access token",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "Crews" ],
        "summary" : "Create a crew",
        "description" : "The caller becomes its first Member, an Administrator.",
        "operationId" : "create",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateCrewRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "The new crew",
            "headers" : {
              "ETag" : {
                "description" : "Send back in If-Match to update it",
                "style" : "simple"
              },
              "Location" : {
                "description" : "The new crew's URL",
                "style" : "simple"
              }
            },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CrewDetails"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid fields",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401" : {
            "description" : "Missing or invalid access token",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/me" : {
      "get" : {
        "tags" : [ "Profile" ],
        "summary" : "Get the signed-in user's profile",
        "description" : "The first call creates the user from the access token; later calls return the same user.",
        "operationId" : "me",
        "responses" : {
          "200" : {
            "description" : "The signed-in user's profile",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "401" : {
            "description" : "Missing or invalid access token",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/crews/{crewId}" : {
      "get" : {
        "tags" : [ "Crews" ],
        "summary" : "Get a crew",
        "description" : "With the caller's own Member id and role.",
        "operationId" : "crew",
        "parameters" : [ {
          "name" : "crewId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The crew",
            "headers" : {
              "ETag" : {
                "description" : "Send back in If-Match to update it",
                "style" : "simple"
              }
            },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CrewDetails"
                }
              }
            }
          },
          "404" : {
            "description" : "No such crew, or the caller isn't a member",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401" : {
            "description" : "Missing or invalid access token",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "CreateCrewRequest" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "maxLength" : 80,
            "minLength" : 0
          },
          "establishedMonth" : {
            "type" : "string",
            "example" : "1999-10",
            "pattern" : "^\\d{4}-\\d{2}$"
          },
          "iconKey" : {
            "type" : "string",
            "enum" : [ "USERS", "DICE", "DINING", "FILM", "BEER", "GAMEPAD", "TROPHY", "MUSIC", "MOUNTAIN", "TENT", "PIZZA", "COFFEE" ]
          },
          "timeZone" : {
            "type" : "string",
            "example" : "America/Chicago",
            "minLength" : 1
          },
          "motto" : {
            "type" : "string",
            "maxLength" : 150,
            "minLength" : 0
          },
          "description" : {
            "type" : "string",
            "maxLength" : 2000,
            "minLength" : 0
          },
          "creatorFirstName" : {
            "type" : "string",
            "maxLength" : 50,
            "minLength" : 0
          }
        },
        "required" : [ "creatorFirstName", "establishedMonth", "iconKey", "name", "timeZone" ]
      },
      "InvalidField" : {
        "type" : "object",
        "properties" : {
          "field" : {
            "type" : "string",
            "description" : "The request property's path, such as socialLinks[0].url; empty for the whole request"
          },
          "message" : {
            "type" : "string"
          }
        },
        "required" : [ "field", "message" ]
      },
      "ProblemDetail" : {
        "type" : "object",
        "description" : "An error, as RFC 9457 Problem Details",
        "properties" : {
          "type" : {
            "type" : "string",
            "format" : "uri",
            "description" : "Identifies the kind of error, e.g. urn:crewup:problem:unauthenticated"
          },
          "title" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "traceId" : {
            "type" : "string",
            "description" : "The request's trace ID; shown to users as the error's reference"
          },
          "errors" : {
            "type" : "array",
            "description" : "Only for urn:crewup:problem:invalid-request: one entry per invalid field",
            "items" : {
              "$ref" : "#/components/schemas/InvalidField"
            }
          }
        },
        "required" : [ "status", "title", "traceId" ]
      },
      "CrewDetails" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "establishedMonth" : {
            "type" : "string",
            "pattern" : "^\\d{4}-\\d{2}$"
          },
          "motto" : {
            "type" : [ "string", "null" ]
          },
          "description" : {
            "type" : [ "string", "null" ]
          },
          "iconKey" : {
            "type" : "string",
            "enum" : [ "USERS", "DICE", "DINING", "FILM", "BEER", "GAMEPAD", "TROPHY", "MUSIC", "MOUNTAIN", "TENT", "PIZZA", "COFFEE" ]
          },
          "timeZone" : {
            "type" : "string",
            "example" : "America/Chicago"
          },
          "myMemberId" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "The caller's Member id in this crew"
          },
          "myRole" : {
            "type" : "string",
            "description" : "The caller's role in this crew",
            "enum" : [ "ADMIN", "FRIEND", "NEW_GUY" ]
          }
        },
        "required" : [ "description", "establishedMonth", "iconKey", "id", "motto", "myMemberId", "myRole", "name", "timeZone" ]
      },
      "UserProfile" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "displayName" : {
            "type" : "string",
            "description" : "Name shown to other members"
          },
          "email" : {
            "type" : [ "string", "null" ],
            "description" : "Null if the identity provider has no email for the user"
          }
        },
        "required" : [ "displayName", "email", "id" ]
      },
      "CrewSummary" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "iconKey" : {
            "type" : "string",
            "enum" : [ "USERS", "DICE", "DINING", "FILM", "BEER", "GAMEPAD", "TROPHY", "MUSIC", "MOUNTAIN", "TENT", "PIZZA", "COFFEE" ]
          },
          "motto" : {
            "type" : [ "string", "null" ]
          },
          "establishedMonth" : {
            "type" : "string",
            "pattern" : "^\\d{4}-\\d{2}$"
          },
          "myRole" : {
            "type" : "string",
            "description" : "The caller's role in this crew",
            "enum" : [ "ADMIN", "FRIEND", "NEW_GUY" ]
          }
        },
        "required" : [ "establishedMonth", "iconKey", "id", "motto", "myRole", "name" ]
      },
      "CursorPageCrewSummary" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/CrewSummary"
            }
          },
          "nextCursor" : {
            "type" : [ "string", "null" ],
            "description" : "Null on the last page"
          }
        },
        "required" : [ "items", "nextCursor" ]
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    }
  }
}
