# Local development settings. Copy to .env (gitignored): cp .env.example .env
# Read by Docker Compose and by the backend (spring.config.import of ../.env).
# Keep the format KEY=value with no quotes or spaces, so both readers agree.
# DEV ONLY: none of these values may be used outside local development.

# PostgreSQL
CREWUP_DB_NAME=crewup
CREWUP_DB_USER=crewup
CREWUP_DB_PASSWORD=crewup-dev-only
CREWUP_DB_PORT=5432

# Keycloak (admin console at http://localhost:8180/admin)
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev-only

# The backend accepts tokens issued by this realm
CREWUP_OIDC_ISSUER_URI=http://localhost:8180/realms/crewup
