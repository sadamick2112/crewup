# Editor settings shared by everyone (M0-22). Formatters (Spotless, Prettier) have the final say.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,xml,sql}]
indent_size = 4

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[{mvnw,mvnw.cmd}]
end_of_line = unset
